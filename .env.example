# Database Configuration
# Local (host / air): localhost
# Production (docker compose on VPS, shared infra network): postgresql
GO_RSS_UI_DB_HOST=localhost
GO_RSS_UI_DB_USER=postgres
GO_RSS_UI_DB_PASSWORD=postgres
GO_RSS_UI_DB_NAME=go_rss_ui
GO_RSS_UI_DB_PORT=5432
GO_RSS_UI_DB_SSLMODE=disable
GO_RSS_UI_DB_TIMEZONE=Asia/Shanghai

# Alternative: You can also use GO_RSS_UI_DATABASE_URL instead of individual parameters
# GO_RSS_UI_DATABASE_URL=host=localhost user=postgres password=postgres dbname=go_rss_ui port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Local (host / air): localhost
# Production (docker compose on VPS, shared infra network): redis
GO_RSS_UI_REDIS_HOST=localhost
GO_RSS_UI_REDIS_PORT=6379
GO_RSS_UI_REDIS_PASSWORD=

GO_RSS_UI_BACKGROUND_FETCH_ENABLED=true
GO_RSS_UI_BACKGROUND_FETCH_INTERVAL=300
GO_RSS_UI_CYPRESS=0
GO_RSS_UI_PORT=8082

# Session configuration
# In production set GO_RSS_UI_ENV=production and provide a long unique secret.
GO_RSS_UI_ENV=development
GO_RSS_UI_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional explicit override. By default secure cookies are enabled automatically in production.
GO_RSS_UI_SESSION_SECURE=0
