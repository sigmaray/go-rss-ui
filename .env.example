# Database Configuration
RSS_DB_HOST=localhost
RSS_DB_USER=postgres
RSS_DB_PASSWORD=postgres
RSS_DB_NAME=go_rss_ui_2
RSS_DB_PORT=5432
RSS_DB_SSLMODE=disable
RSS_DB_TIMEZONE=Asia/Shanghai

# Alternative: You can also use RSS_DATABASE_URL instead of individual parameters
# RSS_DATABASE_URL=host=localhost user=postgres password=postgres dbname=go_rss_ui_2 port=5432 sslmode=disable TimeZone=Asia/Shanghai

RSS_REDIS_HOST=localhost
RSS_REDIS_PORT=6379
RSS_REDIS_PASSWORD=

RSS_BACKGROUND_FETCH_ENABLED=true
RSS_BACKGROUND_FETCH_INTERVAL=300
RSS_CYPRESS=0
RSS_PORT=8082

# Session configuration
# In production set RSS_ENV=production and provide a long unique secret.
RSS_ENV=development
RSS_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional explicit override. By default secure cookies are enabled automatically in production.
RSS_SESSION_SECURE=0
